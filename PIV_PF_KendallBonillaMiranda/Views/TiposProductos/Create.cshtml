@model PIV_PF_KendallBonillaMiranda.TiposProductos

@{
    ViewBag.Title = "Crear";
}

<h2>Crear</h2>


@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <h4>Tipo de Producto</h4>
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="form-group">
            @Html.LabelFor(model => model.TipoNombre, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.TextBoxFor(model => model.TipoNombre, new { @class = "form-control", @onkeyup = "convertToProperCase(this); checkFields()" })
                @Html.ValidationMessageFor(model => model.TipoNombre, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Crear" class="btn btn-default" id="createButton" disabled />
            </div>
        </div>
    </div>
}

<div>
    @Html.ActionLink("Volver a la lista", "Index")
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

<script>
    function checkFields() {
        var tipoNombre = document.getElementById("TipoNombre").value;
        var createButton = document.getElementById("createButton");

        if (tipoNombre.trim() == "") {
            createButton.disabled = true;
        } else {
            createButton.disabled = false;
        }
    }

    function convertToProperCase(input) {
        var text = input.value.toLowerCase();
        var properCaseText = text.replace(/\b\w/g, function (char) {
            return char.toUpperCase();
        });
        input.value = properCaseText;
    }

    document.getElementById("TipoNombre").addEventListener("input", checkFields);
</script>
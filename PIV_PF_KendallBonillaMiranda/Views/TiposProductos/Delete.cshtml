@model PIV_PF_KendallBonillaMiranda.TiposProductos

@{
    ViewBag.Title = "Eliminar";
}

<h2>Eliminar</h2>

<h3>¿Estás seguro de que deseas eliminar esto?</h3>
<div>
    <h4>Tipo de Producto</h4>
    <hr />
    <dl class="dl-horizontal">
        <dt>
            @Html.DisplayNameFor(model => model.TipoID)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.TipoID)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.TipoNombre)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.TipoNombre)
        </dd>
    </dl>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="form-actions no-color">
            <input type="submit" value="Eliminar" class="btn btn-default" /> |
            @Html.ActionLink("Volver a la lista", "Index")
        </div>
    }
</div>
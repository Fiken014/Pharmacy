<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Farmacia UAM </title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    <div class="navbar navbar-inverse navbar-fixed-top">
        <div class="container">
            <div class="navbar-header">
                <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>
                @Html.ActionLink("PIV PF Proyecto Final", "Login", "Usuarios", new { area = "" }, new { @class = "navbar-brand" })
            </div>
            <div class="navbar-collapse collapse">
                @if (!string.IsNullOrEmpty(Session["NombreCompleto"] as string) && Session["TipoUsuario"].ToString() == "Administrador")
                {
                    <ul class="nav navbar-nav">
                        <li>@Html.ActionLink("Usuarios", "Index", "Usuarios")</li>
                        <li>@Html.ActionLink("Clientes", "Index", "Clientes")</li>
                        <li>@Html.ActionLink("Productos", "Index", "Productos")</li>
                        <li>@Html.ActionLink("Tipos de Productos", "Index", "TiposProductos")</li>
                        <li>@Html.ActionLink("Pedidos", "Index", "Pedidos")</li>
                    </ul>
                }
                else if (!string.IsNullOrEmpty(Session["NombreCompleto"] as string) && Session["TipoUsuario"].ToString() == "Empleado")
                {
                    <ul class="nav navbar-nav">
                        <li>@Html.ActionLink("Clientes", "Index", "Clientes")</li>
                        <li>@Html.ActionLink("Pedidos", "Index", "Pedidos")</li>
                    </ul>
                }
                else if (!string.IsNullOrEmpty(Session["NombreCompleto"] as string) && Session["TipoUsuario"].ToString() == "Contabilidad")
                {
                    <ul class="nav navbar-nav">
                        <li>@Html.ActionLink("Pedidos", "Index", "Pedidos")</li>
                    </ul>
                }
                @{
                    var logoutUrl = Url.Action("Logout", "Usuarios");
                }
                @if (!string.IsNullOrEmpty(Session["NombreCompleto"] as string))
                {
                    <p class="navbar-text pull-right" style="margin-right: 10px;">
                        Logged in as @Session["NombreCompleto"] (@Session["TipoUsuario"])
                        <a href="@logoutUrl" class="btn btn-sm btn-transparent" style="color: white;" title="Logout"><span class='glyphicon glyphicon-off'></span></a>
                    </p>
                }
            </div>
        </div>
    </div>
    <div class="container body-content">
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - Programación IV - Proyecto Final</p>
            <img src="@Url.Content("~/Content/Images/universidad-americana-de-costa-rica-logo.png")" alt="Universidad Americana de Costa Rica" width="75" height="25">
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>